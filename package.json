{
  "name": "@iamankeshsharma/eslint-config",
  "version": "1.1.2",
  "description": "Zero-config ESLint setup for Next.js, TypeScript & Tailwind (ESLint v9 Flat Config)",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamankeshsharma/eslint-config"
  },
  "scripts": {
    "release": "standard-version"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint flat config",
    "typescript eslint",
    "nextjs eslint",
    "tailwind eslint",
    "react eslint",
    "eslint v9",
    "monorepo eslint",
    "zero config eslint"
  ],
  "author": "Ankesh Sharma",
  "homepage": "https://github.com/iamankeshsharma/eslint-config",
  "bugs": {
    "url": "https://github.com/iamankeshsharma/eslint-config/issues"
  },
  "files": [
    "base",
    "react",
    "next",
    "tailwind"
  ],
  "exports": {
    ".": "./base/index.js",
    "./react": "./react/index.js",
    "./tailwind": "./tailwind/index.js",
    "./next": "./next/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "@next/eslint-plugin-next": ">=14",
    "eslint-config-prettier": ">=9",
    "eslint-plugin-import": ">=2",
    "eslint-plugin-react": ">=7",
    "eslint-plugin-react-hooks": ">=4",
    "eslint-plugin-simple-import-sort": ">=12",
    "eslint-plugin-sonarjs": ">=4",
    "eslint-plugin-tailwindcss": ">=3",
    "eslint-plugin-unicorn": ">=63",
    "typescript-eslint": ">=8"
  },
  "peerDependenciesMeta": {
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "eslint-plugin-tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^16.2.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "standard-version": "^9.5.0"
  }
}
